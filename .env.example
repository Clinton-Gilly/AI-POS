# ============================================================================
# AI-POS — environment variables
#
# Copy to .env.local and fill in real values. Never commit .env files.
#
# Rules:
#   • Only NEXT_PUBLIC_* variables reach the browser. Everything else is
#     server-only — a secret in a NEXT_PUBLIC_ variable is a secret leak.
#   • All variables are validated by Zod at boot in src/config/env.ts.
#     A missing or malformed value stops the app from starting, on purpose.
#   • Only src/config/env.ts reads process.env. Nothing else.
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI-POS

# ----------------------------------------------------------------------------
# Convex — database and backend functions
# `npx convex dev` writes these for a local dev deployment.
# ----------------------------------------------------------------------------
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ----------------------------------------------------------------------------
# Clerk — authentication (identity only; tenancy and roles live in Convex)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Issuer domain used by convex/auth.config.ts to verify Clerk JWTs.
#
# This one is set on the CONVEX deployment, not in .env.local:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
#
# It must match a Clerk JWT template named exactly "convex". Without it,
# ctx.auth.getUserIdentity() returns null and every tenant function fails
# closed with UNAUTHENTICATED.
CLERK_JWT_ISSUER_DOMAIN=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ----------------------------------------------------------------------------
# M-Pesa (Safaricom Daraja) — SERVER ONLY
#
# Sandbox and production are separate deployments with separate credentials,
# never a runtime flag. There is no code path that fakes a successful payment
# in any environment.
# ----------------------------------------------------------------------------
MPESA_ENVIRONMENT=sandbox           # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_SHORTCODE_TYPE=paybill        # paybill | till

# Publicly reachable HTTPS callback base (use a tunnel in local development).
MPESA_CALLBACK_BASE_URL=

# Unguessable token embedded in the callback path, checked on every request.
# Generate with: openssl rand -hex 32
MPESA_CALLBACK_TOKEN=

# Comma-separated Safaricom callback source IPs (allowlist).
MPESA_ALLOWED_IPS=

# ----------------------------------------------------------------------------
# AI providers — SERVER ONLY
#
# At least one is required for the assistant. The active provider is chosen by
# configuration; business logic never names a model.
# ----------------------------------------------------------------------------
AI_DEFAULT_PROVIDER=anthropic       # openai | gemini | anthropic

OPENAI_API_KEY=
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Per-business daily cap on assistant requests (cost control).
AI_RATE_LIMIT_PER_BUSINESS_PER_DAY=500

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info                      # debug | info | warn | error

# ----------------------------------------------------------------------------
# Feature flags
# ----------------------------------------------------------------------------
FEATURE_OFFLINE_POS=true
FEATURE_AI_ASSISTANT=true
FEATURE_AI_INSIGHTS=true

# ----------------------------------------------------------------------------
# Notifications (Phase 8 — SMS / WhatsApp receipt delivery)
# ----------------------------------------------------------------------------
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_ID=
